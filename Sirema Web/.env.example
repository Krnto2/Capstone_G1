# Copie este archivo como .env y cambie TODOS los valores antes de levantar SIREMA.
# La configuración se entrega solo por variables de entorno (RNF-06).

# Django
DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria-de-50-caracteres
DJANGO_ALLOWED_HOSTS=sirema.local,192.168.1.10,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://sirema.local,https://192.168.1.10

# PostgreSQL 16 (contenedor sirema-db)
POSTGRES_DB=sirema
POSTGRES_USER=sirema
POSTGRES_PASSWORD=cambie-esta-contrasena

# Primer administrador (se crea solo si no existe ninguno)
SIREMA_ADMIN_CORREO=admin@octava.cl
SIREMA_ADMIN_RUT=11.111.111-1
SIREMA_ADMIN_NOMBRE=Administrador
SIREMA_ADMIN_APELLIDOS=SIREMA
SIREMA_ADMIN_CONTRASENA=CambieEsto2026

# Programador y servidor
SIREMA_DIAS_ANTICIPACION=7
GUNICORN_WORKERS=3
TZ=America/Santiago
